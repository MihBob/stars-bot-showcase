# --- Telegram ---
BOT_TOKEN=123456:AAAA-your-bot-token
ADMIN_CHAT_ID=123456789
# Отдельная группа/канал для уведомлений о заказах (необязательно).
ORDERS_CHAT_ID=

# TEST — без реальных платежей, LIVE — настоящие.
PAYMENT_MODE=LIVE

# --- Цена ---
STAR_COST_RUB=1.35
MARGIN_PERCENT=15

# --- Приём TON ---
TON_WALLET_ADDRESS=UQ...your_hot_wallet
TONCENTER_API_KEY=
TON_TESTNET=false

# --- Автовыдача ---
# SUPPLIER — автоматически через API поставщика, MANUAL — только вручную через /done.
FULFILLMENT_MODE=SUPPLIER
SUPPLIER_API_KEY=
SUPPLIER_API_BASE=https://api.example.com/v1
SUPPLIER_PAY_CURRENCY=ton
SUPPLIER_CALLBACK_URL=
SUPPLIER_RESUME_MAX_AGE_HOURS=6

# --- Кошельки ---
COLD_WALLET_ADDRESS=UQ...cold_wallet
HOT_WALLET_MNEMONIC=word1 word2 ... word12
HOT_KEEP_TON=1.0
SWEEP_ENABLED=true

# --- Лимиты автозакупки ---
AUTO_MAX_TON_PER_ORDER=7
AUTO_DAILY_SPEND_TON=0
AUTO_MAX_ORDERS_PER_HOUR=10
AUTO_ENABLED=true

# --- Автоматическая цена ---
AUTO_PRICE_ENABLED=true
AUTO_PRICE_INTERVAL_MINUTES=60
AUTO_PRICE_QUANTITY=50
AUTO_PRICE_MARGIN_PERCENT=22
AUTO_PRICE_BUFFER_PERCENT=5
AUTO_PRICE_MIN_PROFIT_RUB=0.10
AUTO_PRICE_FEE_TON=0.02
AUTO_PRICE_MAX_CHANGE_PERCENT=40

# --- Прочее ---
DATABASE_URL=sqlite+aiosqlite:///stars_bot.db
# Прокси для api.telegram.org: socks5://user:pass@host:port или http://...
PROXY_URL=
